# GEMINI_API_KEY: Required if future AI features are enabled server-side.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The canonical URL where this storefront is hosted.
APP_URL="MY_APP_URL"

# ==============================================================================
# SUPABASE CONFIGURATION (Required for Production Database, Auth & Storage)
# ==============================================================================
# Public Supabase Project URL (safe for browser)
NEXT_PUBLIC_SUPABASE_URL=""

# Public Supabase Anonymous Key (safe for browser with RLS enabled)
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# Server-Only Supabase Service Role Key (NEVER prefix with NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=""

# ==============================================================================
# ADMIN & API SECURITY
# ==============================================================================
# Optional server-side session signing secret (falls back to runtime random secret if unset)
ADMIN_SESSION_SECRET=""

# Optional preset admin passcode for Preview Mode before Supabase Auth is connected
ADMIN_BOOTSTRAP_PASSCODE=""

# Optional API key for future external AI Virtual Assistant integration (/api/v1/assistant/*)
ASSISTANT_API_KEY=""

# ==============================================================================
# MULTI-PROVIDER AI & ENCRYPTED CREDENTIALS VAULT
# ==============================================================================
# Optional OpenAI API key fallback (admin can also save encrypted provider keys via /admin)
OPENAI_API_KEY=""

# Optional 32+ character secret used to AES-256-GCM encrypt AI provider keys stored by admin
CREDENTIALS_ENCRYPTION_KEY=""
